---
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { en } from '../i18n/en';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: en.site.personSchema.name,
	alternateName: en.site.personSchema.alternateName,
	url: en.site.canonicalHome,
	jobTitle: en.site.personSchema.jobTitle,
	alumniOf: en.site.personSchema.alumniOf,
	address: {
		'@type': 'PostalAddress',
		addressLocality: en.site.personSchema.addressLocality,
		addressCountry: en.site.personSchema.addressCountry,
	},
	sameAs: [...en.site.personSchema.sameAs],
};
---

<html lang={en.language}>
	<head>
		<meta charset="utf-8" />
		<ClientRouter />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={en.metadata.description} />
		<link rel="canonical" href={en.site.canonicalHome} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={en.site.canonicalHome} />
		<meta property="og:title" content={en.metadata.title} />
		<meta property="og:description" content={en.metadata.description} />
		<meta property="og:image" content={en.site.ogImage} />
		<meta property="og:image:alt" content={en.site.ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="google-site-verification" content={en.site.googleSiteVerification} />
		<meta name="theme-color" content={en.metadata.themeColor} />
		<title>{en.metadata.title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</head>
	<body>
		<Navigation />
		<main>
			<Hero />
			<Experience />
			<Skills />
			<Projects />
			<Contact />
		</main>
		<Footer />
		<script>
			import { initFluidMotion, animateDialogOpen } from '../scripts/fluid-motion';
			import { initPortraitMosaic } from '../scripts/portrait-mosaic';

			function setupIndexPage() {
				const hero = document.getElementById('hero');
				if (!hero) return;

				const sections = document.querySelectorAll<HTMLElement>('.section');
				sections.forEach((section) => {
					section.classList.remove('section-reveal', 'is-visible');
					section.style.opacity = '1';
				});
				initFluidMotion();
				initPortraitMosaic();

				const prefersReduced = () =>
					window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				const lockPageScroll = () => {
					document.documentElement.classList.add('modal-open');
					document.body.classList.add('modal-open');
				};

				const unlockPageScroll = () => {
					const anyOpen = document.querySelectorAll('dialog[open]').length > 0;
					if (!anyOpen) {
						document.documentElement.classList.remove('modal-open');
						document.body.classList.remove('modal-open');
					}
				};

				const openDialog = (dialog: HTMLDialogElement, onOpened?: () => void) => {
					if (dialog.open) {
						onOpened?.();
						return;
					}
					lockPageScroll();
					window.requestAnimationFrame(() => {
						if (dialog.open) {
							onOpened?.();
							return;
						}
						dialog.showModal();
						animateDialogOpen(dialog);
						onOpened?.();
					});
				};

				const resolveProjectDialog = (
					dialogId: string | null | undefined
				): HTMLDialogElement | null => {
					if (!dialogId) return null;
					const dialogElement =
						document.getElementById(dialogId) ||
						(dialogId === 'redcarpet-dialog'
							? document.getElementById('redcarpet-case-study')
							: null);
					return dialogElement instanceof HTMLDialogElement ? dialogElement : null;
				};

				const isModifiedClick = (event: MouseEvent) =>
					event.button !== 0 ||
					event.metaKey ||
					event.ctrlKey ||
					event.shiftKey ||
					event.altKey;

				unlockPageScroll();

				const cards = document.querySelectorAll<HTMLElement>('[data-interactive-card]');
				cards.forEach((card) => {
					if (card.dataset.cardBound === '1') return;
					card.dataset.cardBound = '1';

					const press = () => {
						card.classList.add('is-pressed');
						window.setTimeout(() => card.classList.remove('is-pressed'), 160);
					};
					const dialogId = card.dataset.projectTrigger ?? card.dataset.dialogTrigger;
					const projectDialog = resolveProjectDialog(dialogId);

					const openProject = (event: MouseEvent) => {
						if (isModifiedClick(event)) return;
						event.preventDefault();
						if (projectDialog) openDialog(projectDialog);
					};

					if (projectDialog) {
						card.addEventListener('click', openProject);
						card.querySelectorAll<HTMLAnchorElement>('a').forEach((anchor) => {
							anchor.addEventListener('click', (event) => {
								if (isModifiedClick(event)) {
									event.stopPropagation();
									return;
								}
								event.preventDefault();
								event.stopPropagation();
								press();
								openDialog(projectDialog);
							});
						});
					}

					card.addEventListener('click', press);
					card.addEventListener('keydown', (event) => {
						if (event.key === 'Enter' || event.key === ' ') {
							event.preventDefault();
							press();
							if (projectDialog) {
								openDialog(projectDialog);
							}
						}
					});
				});

				document
					.querySelectorAll<HTMLElement>('[data-project-trigger]')
					.forEach((trigger) => {
						const parentCard = trigger.closest<HTMLElement>('[data-interactive-card]');
						if (
							parentCard &&
							(parentCard === trigger ||
								resolveProjectDialog(
									parentCard.dataset.projectTrigger ?? parentCard.dataset.dialogTrigger
								))
						) {
							return;
						}
						if (trigger.dataset.projectTriggerBound === '1') return;
						trigger.dataset.projectTriggerBound = '1';

						const dialog = resolveProjectDialog(trigger.dataset.projectTrigger);
						if (!dialog) return;

						trigger.addEventListener('click', (event) => {
							if (event instanceof MouseEvent && isModifiedClick(event)) {
								return;
							}
							event.preventDefault();
							openDialog(dialog);
						});
					});

				document
					.querySelectorAll<HTMLDialogElement>('.project-dialog, .certificate-preview')
					.forEach((dialog) => {
						if (dialog.dataset.dialogBound === '1') return;
						dialog.dataset.dialogBound = '1';

						dialog
							.querySelector<HTMLButtonElement>('.project-dialog-close, .certificate-preview-close')
							?.addEventListener('click', () => {
								dialog.close();
							});

						dialog.addEventListener('click', (event) => {
							if (event.target === dialog) {
								dialog.close();
							}
						});

						dialog.addEventListener('close', unlockPageScroll);

						dialog.addEventListener('keydown', (event) => {
							if (event.key !== 'Tab') return;
							const focusable = Array.from(
								dialog.querySelectorAll<HTMLElement>(
									'button, a, input, select, textarea, [tabindex]:not([tabindex="-1"])'
								)
							).filter((element) => !element.hasAttribute('disabled'));
							if (!focusable.length) return;
							const first = focusable[0];
							const last = focusable[focusable.length - 1];
							if (event.shiftKey && document.activeElement === first) {
								event.preventDefault();
								last.focus();
							} else if (!event.shiftKey && document.activeElement === last) {
								event.preventDefault();
								first.focus();
							}
						});
					});

				const toolsDialog = document.querySelector<HTMLDialogElement>('#tools-dialog');
				const toolsDialogClose = toolsDialog?.querySelector<HTMLButtonElement>('.tools-dialog-close');
				let toolsDialogTrigger: HTMLElement | null = null;

				const openToolsDialog = (trigger: HTMLElement, toolName?: string) => {
					if (!toolsDialog) return;
					toolsDialogTrigger = trigger;
					openDialog(toolsDialog, () => {
						toolsDialogClose?.focus();
						if (!toolName) return;
						const matchingChip = Array.from(
							toolsDialog.querySelectorAll<HTMLElement>('.tool-chip')
						).find((chip) => chip.dataset.toolName === toolName);
						if (!matchingChip) return;
						matchingChip.classList.add('is-highlighted');
						matchingChip.scrollIntoView({
							block: 'center',
							behavior: prefersReduced() ? 'auto' : 'smooth',
						});
						window.setTimeout(() => matchingChip.classList.remove('is-highlighted'), 1200);
					});
				};

				document
					.querySelectorAll<HTMLButtonElement>('.tools-column .tool-chip')
					.forEach((chip) => {
						if (chip.dataset.chipBound === '1') return;
						chip.dataset.chipBound = '1';
						chip.addEventListener('click', () =>
							openToolsDialog(chip, chip.dataset.toolName)
						);
					});

				document
					.querySelectorAll<HTMLButtonElement>('[data-tools-dialog-trigger]')
					.forEach((trigger) => {
						if (trigger.dataset.triggerBound === '1') return;
						trigger.dataset.triggerBound = '1';
						trigger.addEventListener('click', (event) => {
							openToolsDialog(event.currentTarget as HTMLElement);
						});
					});

				if (toolsDialog && toolsDialog.dataset.focusBound !== '1') {
					toolsDialog.dataset.focusBound = '1';
					toolsDialog.addEventListener('close', () => {
						toolsDialogTrigger?.focus();
						toolsDialogTrigger = null;
					});
				}

				const certificatePreview = document.querySelector<HTMLDialogElement>('#certificate-preview');
				const certificatePreviewImage = document.querySelector<HTMLImageElement>(
					'#certificate-preview-image'
				);
				const certificatePreviewTitle = document.querySelector<HTMLElement>(
					'#certificate-preview-title'
				);

				document
					.querySelectorAll<HTMLAnchorElement>('.certificate-preview-trigger')
					.forEach((certificate) => {
						if (certificate.dataset.previewBound === '1') return;
						certificate.dataset.previewBound = '1';
						certificate.addEventListener('click', (event) => {
							event.preventDefault();
							if (
								!certificatePreview ||
								!certificatePreviewImage ||
								!certificatePreviewTitle
							)
								return;
							certificatePreviewImage.src =
								certificate.dataset.previewSrc ?? certificate.href;
							certificatePreviewImage.alt =
								certificate.dataset.previewTitle ??
								certificatePreview.dataset.fallbackAlt ??
								'Certificate preview';
							certificatePreviewTitle.textContent =
								certificate.dataset.previewTitle ?? '';
							openDialog(certificatePreview);
						});
					});

				const triggers = document.querySelectorAll<HTMLElement>(
					'[data-dialog-target], [data-modal-target], [data-dialog-trigger], [data-project-trigger], [data-tools-dialog-trigger], .tools-view-all, .certificate-card'
				);

				triggers.forEach((btn) => {
					if (btn.dataset.prewarmBound === '1') return;
					btn.dataset.prewarmBound = '1';
					btn.addEventListener(
						'mouseenter',
						() => {
							let targetId =
								btn.getAttribute('data-dialog-target') ||
								btn.getAttribute('data-modal-target') ||
								btn.getAttribute('data-dialog-trigger') ||
								btn.getAttribute('data-project-trigger');
							if (
								!targetId &&
								(btn.hasAttribute('data-tools-dialog-trigger') ||
									btn.classList.contains('tools-view-all'))
							) {
								targetId = 'tools-dialog';
							}
							if (!targetId && btn.classList.contains('certificate-card')) {
								targetId = 'certificates-dialog';
							}
							if (!targetId) return;
							const dialog =
								document.getElementById(targetId) ||
								(targetId === 'redcarpet-dialog'
									? document.getElementById('redcarpet-case-study')
									: null);
							if (!dialog || dialog.dataset.prewarmed === 'true') return;

							const firstImages =
								dialog.querySelectorAll<HTMLImageElement>('img[loading="lazy"]');
							firstImages.forEach((img, idx) => {
								if (idx < 8) {
									img.loading = 'eager';
									if ('decode' in img) {
										img.decode().catch(() => {});
									}
								}
							});
							dialog.dataset.prewarmed = 'true';
						},
						{ passive: true }
					);
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', setupIndexPage);
			} else {
				setupIndexPage();
			}
			document.addEventListener('astro:page-load', setupIndexPage);
		</script>
	</body>
</html>
