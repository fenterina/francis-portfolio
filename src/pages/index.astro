---
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import { en } from '../i18n/en';
import '../styles/global.css';
---

<html lang={en.language}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/images/logo-white.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={en.metadata.description} />
		<meta name="google-site-verification" content="M2nUoE72IQRMfIMna9vfpk-IdyZtdXDjzvl3WGyyCuA" />
		<meta name="theme-color" content={en.metadata.themeColor} />
		<title>{en.metadata.title}</title>
	</head>
	<body>
		<Navigation />
		<main>
			<Hero />
			<About />
			<Experience />
			<Skills />
			<Projects />
			<Contact />
		</main>
		<script>
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const sections = document.querySelectorAll<HTMLElement>('.section');
			const cards = document.querySelectorAll<HTMLElement>('[data-interactive-card]');
			let lockedScrollY = 0;
			let lockedBodyStyles = '';
			const lockPageScroll = () => {
				lockedScrollY = window.scrollY;
				lockedBodyStyles = document.body.getAttribute('style') ?? '';
				document.body.style.position = 'fixed';
				document.body.style.top = `-${lockedScrollY}px`;
				document.body.style.left = '0';
				document.body.style.right = '0';
				document.body.style.width = '100%';
			};
			const unlockPageScroll = () => {
				document.body.setAttribute('style', lockedBodyStyles);
				window.scrollTo(0, lockedScrollY);
			};
			const openDialog = (dialog: HTMLDialogElement) => {
				if (dialog.open) return;
				lockPageScroll();
				dialog.showModal();
			};

			if (!prefersReducedMotion) {
				sections.forEach((section) => section.classList.add('section-reveal'));
				const sectionObserver = new IntersectionObserver((entries, observer) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					});
				}, { threshold: 0.12 });
				sections.forEach((section) => sectionObserver.observe(section));
			}

			const navigationLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.logo, #primary-navigation a[href^="#"]'));
			const navigationSections = navigationLinks
				.map((link) => document.getElementById(link.getAttribute('href')?.slice(1) ?? ''))
				.filter((section): section is HTMLElement => section instanceof HTMLElement);
			const setActiveNavigation = (sectionId: string) => {
				navigationLinks.forEach((link) => {
					const isActive = link.getAttribute('href') === `#${sectionId}`;
					link.classList.toggle('is-active', isActive);
					if (isActive) {
						link.setAttribute('aria-current', 'true');
					} else {
						link.removeAttribute('aria-current');
					}
				});
			};
			const initialHash = window.location.hash.slice(1);
			const initialSection = navigationSections.find((section) => section.id === initialHash);
			if (initialSection) setActiveNavigation(initialSection.id);

			const navigationHeader = document.querySelector<HTMLElement>('.site-nav');
			const headerHeight = navigationHeader?.getBoundingClientRect().height ?? 0;
			const sectionVisibility = new Map<HTMLElement, IntersectionObserverEntry>();
			const sectionSpy = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					const section = entry.target instanceof HTMLElement ? entry.target : null;
					if (!section) return;
					if (entry.isIntersecting) {
						sectionVisibility.set(section, entry);
					} else {
						sectionVisibility.delete(section);
					}
				});
				const visibleSections = Array.from(sectionVisibility.values())
					.sort((a, b) => Math.abs(a.boundingClientRect.top - window.innerHeight * 0.45) - Math.abs(b.boundingClientRect.top - window.innerHeight * 0.45));
				const activeSection = visibleSections[0]?.target;
				if (activeSection instanceof HTMLElement) setActiveNavigation(activeSection.id);
			}, {
				rootMargin: `-${Math.max(headerHeight, Math.round(window.innerHeight * 0.4))}px 0px -55% 0px`,
				threshold: 0
			});
			navigationSections.forEach((section) => sectionSpy.observe(section));

			const lastNavigationSection = navigationSections.at(-1);
			if (lastNavigationSection) {
				const bottomObserver = new IntersectionObserver((entries) => {
					const atPageBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
					if (atPageBottom && entries.some((entry) => entry.isIntersecting)) {
						setActiveNavigation(lastNavigationSection.id);
					}
				});
				bottomObserver.observe(lastNavigationSection);
			}

			cards.forEach((card) => {
				const press = () => {
					card.classList.add('is-pressed');
					window.setTimeout(() => card.classList.remove('is-pressed'), 220);
				};
				const dialogId = card.dataset.projectTrigger ?? card.dataset.dialogTrigger;
				const dialogElement = dialogId ? document.getElementById(dialogId) : null;
				const projectDialog = dialogElement instanceof HTMLDialogElement ? dialogElement : null;
				const openProject = (event: Event) => {
					event.preventDefault();
					if (projectDialog) openDialog(projectDialog);
				};
				if (projectDialog) {
					card.addEventListener('click', openProject);
					card.querySelector('a')?.addEventListener('click', (event) => {
						event.preventDefault();
						event.stopPropagation();
						openDialog(projectDialog);
					});
				}
				card.addEventListener('click', press);
				card.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault();
						press();
						if (projectDialog) {
							openDialog(projectDialog);
						}
					}
				});
			});

			document.querySelectorAll<HTMLDialogElement>('.project-dialog').forEach((dialog) => {
				dialog.querySelector<HTMLButtonElement>('.project-dialog-close')?.addEventListener('click', () => {
					dialog.close();
				});
				dialog.addEventListener('click', (event) => {
					if (event.target === dialog) {
						dialog.close();
					}
				});
				dialog.addEventListener('close', unlockPageScroll);
				dialog.addEventListener('keydown', (event) => {
					if (event.key !== 'Tab') return;
					const focusable = Array.from(dialog.querySelectorAll<HTMLElement>('button, a, input, select, textarea, [tabindex]:not([tabindex="-1"])')).filter((element) => !element.hasAttribute('disabled'));
					if (!focusable.length) return;
					const first = focusable[0];
					const last = focusable[focusable.length - 1];
					if (event.shiftKey && document.activeElement === first) {
						event.preventDefault();
						last.focus();
					} else if (!event.shiftKey && document.activeElement === last) {
						event.preventDefault();
						first.focus();
					}
				});
			});

			const toolsDialog = document.querySelector<HTMLDialogElement>('#tools-dialog');
			const toolsDialogClose = toolsDialog?.querySelector<HTMLButtonElement>('.tools-dialog-close');
			let toolsDialogTrigger: HTMLElement | null = null;
			const openToolsDialog = (trigger: HTMLElement, toolName?: string) => {
				if (!toolsDialog) return;
				toolsDialogTrigger = trigger;
				openDialog(toolsDialog);
				window.requestAnimationFrame(() => {
					toolsDialogClose?.focus();
					if (!toolName) return;
					const matchingChip = Array.from(toolsDialog.querySelectorAll<HTMLButtonElement>('.tool-chip')).find((chip) => chip.dataset.toolName === toolName);
					if (!matchingChip) return;
					matchingChip.classList.add('is-highlighted');
					matchingChip.scrollIntoView({ block: 'center', behavior: prefersReducedMotion ? 'auto' : 'smooth' });
					window.setTimeout(() => matchingChip.classList.remove('is-highlighted'), 1200);
				});
			};
			document.querySelectorAll<HTMLButtonElement>('.tools-column .tool-chip').forEach((chip) => {
				chip.addEventListener('click', () => openToolsDialog(chip, chip.dataset.toolName));
			});
			document.querySelector<HTMLButtonElement>('[data-tools-dialog-trigger]')?.addEventListener('click', (event) => {
				openToolsDialog(event.currentTarget as HTMLElement);
			});
			toolsDialog?.addEventListener('close', () => {
				toolsDialogTrigger?.focus();
				toolsDialogTrigger = null;
			});

			const certificatePreview = document.querySelector<HTMLDialogElement>('#certificate-preview');
			const certificatePreviewImage = document.querySelector<HTMLImageElement>('#certificate-preview-image');
			const certificatePreviewTitle = document.querySelector<HTMLElement>('#certificate-preview-title');
			let certificateScrollY = 0;
			const restoreCertificateScroll = () => {
				window.requestAnimationFrame(() => window.scrollTo(0, certificateScrollY));
			};
			document.querySelectorAll<HTMLAnchorElement>('.certificate-preview-trigger').forEach((certificate) => {
				certificate.addEventListener('click', (event) => {
					event.preventDefault();
					if (!certificatePreview || !certificatePreviewImage || !certificatePreviewTitle) return;
					certificateScrollY = window.scrollY;
					certificatePreviewImage.src = certificate.dataset.previewSrc ?? certificate.href;
					certificatePreviewImage.alt = certificate.dataset.previewTitle ?? 'Certificate preview';
					certificatePreviewTitle.textContent = certificate.dataset.previewTitle ?? '';
					certificatePreview.showModal();
				});
			});
			certificatePreview?.querySelector<HTMLButtonElement>('.certificate-preview-close')?.addEventListener('click', () => {
				certificatePreview.close();
				restoreCertificateScroll();
			});
			certificatePreview?.addEventListener('click', (event) => {
				if (event.target === certificatePreview) {
					certificatePreview.close();
				}
			});
			certificatePreview?.addEventListener('close', restoreCertificateScroll);
		</script>
	</body>
</html>
