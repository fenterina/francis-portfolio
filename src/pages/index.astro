---
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import PortfolioModals from '../components/PortfolioModals';
import { en } from '../i18n/en';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: en.site.personSchema.name,
	alternateName: en.site.personSchema.alternateName,
	url: en.site.canonicalHome,
	jobTitle: en.site.personSchema.jobTitle,
	alumniOf: en.site.personSchema.alumniOf,
	address: {
		'@type': 'PostalAddress',
		addressLocality: en.site.personSchema.addressLocality,
		addressCountry: en.site.personSchema.addressCountry,
	},
	sameAs: [...en.site.personSchema.sameAs],
};
---

<html lang={en.language}>
	<head>
		<meta charset="utf-8" />
		<ClientRouter />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={en.metadata.description} />
		<link rel="canonical" href={en.site.canonicalHome} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={en.site.canonicalHome} />
		<meta property="og:title" content={en.metadata.title} />
		<meta property="og:description" content={en.metadata.description} />
		<meta property="og:image" content={en.site.ogImage} />
		<meta property="og:image:alt" content={en.site.ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="google-site-verification" content={en.site.googleSiteVerification} />
		<meta name="theme-color" content={en.metadata.themeColor} />
		<title>{en.metadata.title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</head>
	<body>
		<Navigation />
		<main>
			<Hero />
			<Experience />
			<Skills />
			<Projects />
			<Contact />
		</main>
		<Footer />
		<PortfolioModals client:load />
		<script>
			import { initFluidMotion } from '../scripts/fluid-motion';
			import { initPortraitMosaic } from '../scripts/portrait-mosaic';
			import { en } from '../i18n/en';
			import type { ModalRequestDetail } from '../components/PortfolioModals';

			let certsPrewarmed = false;
			let redCarpetPrewarmed = false;

			function openPortfolioModal(detail: ModalRequestDetail) {
				window.dispatchEvent(new CustomEvent<ModalRequestDetail>('portfolio:open-modal', { detail }));
			}

			function prewarmImages(urls: string[]) {
				urls.forEach((url) => {
					const img = new Image();
					img.decoding = 'async';
					img.src = encodeURI(url);
					if ('decode' in img) {
						img.decode().catch(() => {});
					}
				});
			}

			function resolveModalType(triggerId: string | null | undefined): 'certificates' | 'redcarpet' | null {
				if (!triggerId) return null;
				if (triggerId === 'certificates-dialog') return 'certificates';
				if (triggerId === 'redcarpet-case-study' || triggerId === 'redcarpet-dialog') {
					return 'redcarpet';
				}
				return null;
			}

			function setupIndexPage() {
				const hero = document.getElementById('hero');
				if (!hero) return;

				const sections = document.querySelectorAll<HTMLElement>('.section');
				sections.forEach((section) => {
					section.classList.remove('section-reveal', 'is-visible');
					section.style.opacity = '1';
				});
				initFluidMotion();
				initPortraitMosaic();

				document.documentElement.classList.remove('modal-open');
				document.body.classList.remove('modal-open');

				const isModifiedClick = (event: MouseEvent) =>
					event.button !== 0 ||
					event.metaKey ||
					event.ctrlKey ||
					event.shiftKey ||
					event.altKey;

				const cards = document.querySelectorAll<HTMLElement>('[data-interactive-card]');
				cards.forEach((card) => {
					if (card.dataset.cardBound === '1') return;
					card.dataset.cardBound = '1';

					const press = () => {
						card.classList.add('is-pressed');
						window.setTimeout(() => card.classList.remove('is-pressed'), 160);
					};
					const triggerId = card.dataset.projectTrigger ?? card.dataset.dialogTrigger;
					const modalType = resolveModalType(triggerId);

					if (modalType) {
						card.addEventListener('click', (event: MouseEvent) => {
							if (isModifiedClick(event)) return;
							event.preventDefault();
							openPortfolioModal({ type: modalType });
						});

						card.querySelectorAll<HTMLAnchorElement>('a').forEach((anchor) => {
							anchor.addEventListener('click', (event) => {
								if (isModifiedClick(event)) {
									event.stopPropagation();
									return;
								}
								event.preventDefault();
								event.stopPropagation();
								press();
								openPortfolioModal({ type: modalType });
							});
						});
					}

					card.addEventListener('click', press);
					card.addEventListener('keydown', (event) => {
						if (event.key === 'Enter' || event.key === ' ') {
							event.preventDefault();
							press();
							if (modalType) {
								openPortfolioModal({ type: modalType });
							}
						}
					});
				});

				document
					.querySelectorAll<HTMLElement>('[data-project-trigger]')
					.forEach((trigger) => {
						const parentCard = trigger.closest<HTMLElement>('[data-interactive-card]');
						if (
							parentCard &&
							(parentCard === trigger ||
								resolveModalType(
									parentCard.dataset.projectTrigger ?? parentCard.dataset.dialogTrigger
								))
						) {
							return;
						}
						if (trigger.dataset.projectTriggerBound === '1') return;
						trigger.dataset.projectTriggerBound = '1';

						const modalType = resolveModalType(trigger.dataset.projectTrigger);
						if (!modalType) return;

						trigger.addEventListener('click', (event) => {
							if (event instanceof MouseEvent && isModifiedClick(event)) {
								return;
							}
							event.preventDefault();
							openPortfolioModal({ type: modalType });
						});
					});

				document
					.querySelectorAll<HTMLButtonElement>('.tools-column .tool-chip')
					.forEach((chip) => {
						if (chip.dataset.chipBound === '1') return;
						chip.dataset.chipBound = '1';
						chip.addEventListener('click', () => {
							openPortfolioModal({ type: 'tools', toolName: chip.dataset.toolName });
						});
					});

				document
					.querySelectorAll<HTMLButtonElement>('[data-tools-dialog-trigger]')
					.forEach((trigger) => {
						if (trigger.dataset.triggerBound === '1') return;
						trigger.dataset.triggerBound = '1';
						trigger.addEventListener('click', () => {
							openPortfolioModal({ type: 'tools' });
						});
					});

				document
					.querySelectorAll<HTMLElement>('.certificate-card, [data-project-trigger]')
					.forEach((btn) => {
						if (btn.dataset.prewarmBound === '1') return;
						btn.dataset.prewarmBound = '1';
						btn.addEventListener(
							'mouseenter',
							() => {
								if (btn.classList.contains('certificate-card') && !certsPrewarmed) {
									certsPrewarmed = true;
									prewarmImages(en.skills.certificates.slice(0, 8).map((c) => c.thumb));
								}
								if (btn.hasAttribute('data-project-trigger') && !redCarpetPrewarmed) {
									redCarpetPrewarmed = true;
									prewarmImages([en.projects.redCarpetCaseStudy.heroImageWebp]);
								}
							},
							{ passive: true }
						);
					});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', setupIndexPage);
			} else {
				setupIndexPage();
			}
			document.addEventListener('astro:page-load', setupIndexPage);
		</script>
	</body>
</html>
