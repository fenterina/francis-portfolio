---
import '../../styles/global.css';
import Navigation from '../../components/Navigation.astro';
import { en } from '../../i18n/en';
import { ClientRouter } from 'astro:transitions';

const caseStudy = en.projects.redCarpetCaseStudy;
---

<html lang={en.language}>
	<head>
		<meta charset="utf-8" />
		<ClientRouter />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={caseStudy.pageDescription} />
		<link rel="canonical" href={caseStudy.canonicalUrl} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={caseStudy.canonicalUrl} />
		<meta property="og:title" content={caseStudy.pageTitle} />
		<meta property="og:description" content={caseStudy.pageDescription} />
		<meta property="og:image" content={`${en.site.url}${caseStudy.heroImage}`} />
		<meta name="theme-color" content={en.metadata.themeColor} />
		<title>{caseStudy.pageTitle}</title>
	</head>
	<body>
		<Navigation />
		<main class="case-study-page">
			<div class="container case-study-content">
				<a class="button button-ghost case-study-back" href="/#projects">
					<span class="btn-icon-roll btn-icon-roll--left" aria-hidden="true">
						<svg class="icon-svg btn-icon-primary" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
							<path d="M12.5 8h-9m0 0L7 4.5M3.5 8 7 11.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<svg class="icon-svg btn-icon-clone" width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
							<path d="M12.5 8h-9m0 0L7 4.5M3.5 8 7 11.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</span>
					<span class="btn-roll-mask">
						<span class="btn-roll-primary">{caseStudy.backLabel}</span>
						<span class="btn-roll-clone" aria-hidden="true">{caseStudy.backLabel}</span>
					</span>
				</a>
				<p class="eyebrow">{caseStudy.eyebrow}</p>
				<h1>{caseStudy.title}</h1>
				<p class="project-dialog-lede">{caseStudy.tagline}</p>
				<div class="project-dialog-facts">
					{caseStudy.meta.map((item) => (
						<div><span>{item.label}</span><strong>{item.value}</strong></div>
					))}
				</div>
				<img class="case-study-hero" src={caseStudy.heroImage} alt={caseStudy.heroAlt} />
				<div class="project-dialog-columns">
					{caseStudy.columns.map((col) => (
						<div>
							<span>{col.label}</span>
							<p>{col.text}</p>
						</div>
					))}
				</div>
				<section class="case-study-section">
					<div class="case-study-section-heading">
						<h2>{caseStudy.rolesHeading}</h2>
					</div>
					<div class="case-study-role-grid">
						{caseStudy.roles.map((role) => (
							<article>
								<h3>{role.title}</h3>
								<p>{role.description}</p>
							</article>
						))}
					</div>
				</section>
				<section class="case-study-section">
					<div class="case-study-section-heading">
						<h2>{caseStudy.featuresHeading}</h2>
					</div>
					<div class="case-study-feature-grid">
						{caseStudy.features.map((feat) => (
							<article>
								<b>{feat.number}</b>
								<div>
									<h3>{feat.title}</h3>
									<p>{feat.description}</p>
								</div>
							</article>
						))}
					</div>
				</section>
				<div class="tag-row">
					{caseStudy.tags.map((tag) => <span class="tag">{tag}</span>)}
				</div>
			</div>
		</main>
		<script>
			import { initFluidMotion } from '../../scripts/fluid-motion';

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initFluidMotion);
			} else {
				initFluidMotion();
			}
			document.addEventListener('astro:page-load', initFluidMotion);
		</script>
	</body>
</html>
