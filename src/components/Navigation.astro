---
import { en } from '../i18n/en';
---

<header class="site-header" id="site-header">
  <div class="site-header-inner">
    <a class="brand-header" href="#top" aria-label={en.nav.homeLabel}>
      <img class="brand-header-logo" src={en.images.brandMark} alt="" width="26" height="26" />
      <span class="brand-header-name">{en.hero.brandTitle}</span>
    </a>

    <nav id="primary-navigation" class="nav-pill-container" aria-label="Primary Navigation">
      <a href="#hero" class="nav-pill-link is-active">Home</a>
      <a href="#about" class="nav-pill-link">{en.nav.about}</a>
      <a href="#experience" class="nav-pill-link">Experience</a>
      <a href="#skills" class="nav-pill-link">{en.nav.skills}</a>
      <a href="#projects" class="nav-pill-link">{en.nav.projects}</a>
      <a href="#contact" class="nav-pill-link">Contact</a>
    </nav>

    <div class="header-actions">
      <button
        class="menu-toggle-pill"
        type="button"
        aria-expanded="false"
        aria-controls="primary-navigation"
        aria-label={en.nav.openLabel}
        data-open-label={en.nav.openLabel}
        data-close-label={en.nav.closeLabel}
      >
        <span class="menu-toggle-bar" aria-hidden="true"></span>
        <span class="menu-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle-pill');
  const navigation = document.querySelector<HTMLElement>('#primary-navigation');
  const links = navigation?.querySelectorAll<HTMLAnchorElement>('a');
  const openLabel = toggle?.dataset.openLabel ?? 'Open navigation';
  const closeLabel = toggle?.dataset.closeLabel ?? 'Close navigation';

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? openLabel : closeLabel);
    toggle.classList.toggle('is-open', !isOpen);
    navigation?.classList.toggle('is-open', !isOpen);
  });

  links?.forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', openLabel);
      toggle?.classList.remove('is-open');
      navigation?.classList.remove('is-open');
    });
  });
</script>
