---
import { en } from '../i18n/en';
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <div class="hero-brand"><img class="hero-brand-image" src={en.images.brandLogo} alt="Francis Enterina logo" /></div>
      <h1 class="visually-hidden">Francis Enterina</h1>
      <p class="hero-quote">{en.hero.brandPhrase}</p>
      <div class="hero-actions"><a class="button button-primary" href={en.hero.workLink}>{en.hero.workLabel} <span aria-hidden="true">-></span></a><a class="button button-ghost" href={en.hero.contactLink}>{en.hero.contactLabel}</a></div>
    </div>
  </div>
</section>