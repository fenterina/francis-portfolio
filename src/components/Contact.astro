---
import { en } from '../i18n/en';
---

<section class="contact" id="contact"><div class="container section contact-grid"><div><span class="eyebrow">{en.contact.eyebrow}</span><h2 class="section-heading">{en.contact.title}</h2><p class="section-intro">{en.contact.intro}</p><a class="button button-primary" href={en.contact.emailHref}>{en.contact.ctaLabel} <span aria-hidden="true">-></span></a></div><div class="contact-details"><a href={en.contact.emailHref}>{en.contact.email}</a>{en.contact.social.map((social) => <a href={social.href} target="_blank" rel="noreferrer">{social.label} <span aria-hidden="true">-></span></a>)}</div></div><footer class="site-footer"><div class="container footer-inner"><span>{en.footer.copyright}</span><a href="#top">{en.footer.backToTop} ^</a></div></footer></section>