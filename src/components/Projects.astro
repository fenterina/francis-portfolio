---
import { en } from '../i18n/en';

const redcarpet = en.projects.redCarpetCaseStudy;
---

<section class="section projects" id="projects">
  <div class="container">
    <div class="projects-top">
      <div>
        <h2 class="section-heading">{en.projects.title}</h2>
      </div>
    </div>
    <div class="project-grid">
      {
        en.projects.items.map((project) => {
          const isRedCarpet = project.preview === 'preview-red-carpet';
          const isExternalLink = project.href.startsWith('http');

          return (
            <article
              class={`project-card${isRedCarpet ? ' interactive-card' : ''}`}
              data-interactive-card={isRedCarpet ? '' : undefined}
              data-project-trigger={isRedCarpet ? 'redcarpet-case-study' : undefined}
              tabindex={isRedCarpet ? 0 : undefined}
            >
              <div class={`project-preview ${project.preview}`} aria-hidden="true">
                {isRedCarpet ? (
                  <img
                    class="red-carpet-card-image"
                    src={redcarpet.heroImage}
                    alt=""
                  />
                ) : project.preview === 'preview-infinite-towers' ? (
                  <svg class="project-art-svg" viewBox="0 0 360 210" fill="none">
                    <rect width="360" height="210" rx="14" fill="#0B1128" fill-opacity="0.45" stroke="rgba(169,186,242,0.22)" />
                    <path d="M72 178V96l18-24 18 24v82M252 178V86l18-24 18 24v92" stroke="#4169E1" stroke-width="1.5" stroke-opacity="0.6" />
                    <path d="M128 178V74l24-32 28 24 28-24 24 32v104" fill="#10193A" stroke="#A9BAF2" stroke-width="1.5" stroke-opacity="0.7" />
                    <path d="M156 178v-54a24 24 0 0 1 48 0v54" fill="rgba(65,105,225,0.28)" stroke="#A9BAF2" stroke-width="1.5" />
                    <polygon points="180,90 192,108 180,126 168,108" fill="#4169E1" stroke="#F5F8FF" stroke-width="1.25" />
                    <line x1="44" y1="178" x2="316" y2="178" stroke="rgba(169,186,242,0.35)" stroke-width="1.5" />
                  </svg>
                ) : project.preview === 'preview-portfolio' ? (
                  <svg class="project-art-svg" viewBox="0 0 360 210" fill="none">
                    <rect width="360" height="210" rx="14" fill="#F8FBFF" stroke="#C5D5EE" />
                    <rect x="26" y="24" width="136" height="16" rx="4" fill="#151B54" />
                    <rect x="26" y="50" width="196" height="10" rx="4" fill="#4169E1" fill-opacity="0.35" />
                    <rect x="26" y="76" width="96" height="58" rx="12" fill="#FFFFFF" stroke="#CFDDF2" />
                    <rect x="132" y="76" width="96" height="58" rx="12" fill="#FFFFFF" stroke="#CFDDF2" />
                    <rect x="238" y="76" width="96" height="58" rx="12" fill="#121C45" />
                    <rect x="116" y="156" width="128" height="32" rx="16" fill="#0B1128" />
                    <circle cx="134" cy="172" r="6" fill="#A9BAF2" />
                    <rect x="192" y="163" width="44" height="18" rx="9" fill="#FFFFFF" />
                  </svg>
                ) : (
                  <svg class="project-art-svg" viewBox="0 0 360 210" fill="none">
                    <rect width="360" height="210" rx="14" fill="rgba(11,17,40,0.45)" stroke="rgba(169,186,242,0.24)" />
                    <rect x="34" y="28" width="84" height="154" rx="16" fill="#10193A" stroke="rgba(169,186,242,0.38)" />
                    <rect x="46" y="48" width="60" height="26" rx="7" fill="#4169E1" fill-opacity="0.5" />
                    <rect x="46" y="84" width="60" height="10" rx="4" fill="rgba(245,248,255,0.72)" />
                    <rect x="46" y="102" width="44" height="8" rx="4" fill="rgba(169,186,242,0.5)" />
                    <rect x="138" y="28" width="84" height="154" rx="16" fill="#10193A" stroke="rgba(169,186,242,0.38)" />
                    <circle cx="180" cy="76" r="22" fill="rgba(65,105,225,0.28)" stroke="#A9BAF2" stroke-width="1.5" />
                    <path d="m172 76 6 6 12-12" stroke="#F5F8FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <rect x="150" y="114" width="60" height="10" rx="4" fill="rgba(245,248,255,0.75)" />
                    <rect x="150" y="132" width="42" height="8" rx="4" fill="rgba(169,186,242,0.5)" />
                    <rect x="242" y="28" width="84" height="154" rx="16" fill="#10193A" stroke="rgba(169,186,242,0.38)" />
                    <rect x="254" y="54" width="14" height="72" rx="4" fill="rgba(169,186,242,0.38)" />
                    <rect x="276" y="76" width="14" height="50" rx="4" fill="#4169E1" />
                    <rect x="298" y="44" width="14" height="82" rx="4" fill="#A9BAF2" />
                    <rect x="254" y="142" width="60" height="10" rx="4" fill="rgba(245,248,255,0.72)" />
                  </svg>
                )}
              </div>
              <div class="project-body">
                <div class="project-meta">
                  <span>{project.category}</span>
                  {isRedCarpet || isExternalLink ? (
                    <a
                      href={project.href}
                      target={isExternalLink ? '_blank' : undefined}
                      rel={isExternalLink ? 'noreferrer' : undefined}
                      data-project-trigger={isRedCarpet ? 'redcarpet-case-study' : undefined}
                    >
                      <span>{project.linkLabel}</span>
                      <svg class="icon-svg" width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        {isExternalLink ? (
                          <path d="M4.75 11.25 11.25 4.75m0 0H5.75m5.5 0v5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                        ) : (
                          <path d="M3.5 8h9m0 0-3.5-3.5M12.5 8 9 11.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                        )}
                      </svg>
                    </a>
                  ) : (
                    <span class="project-status-label">{project.linkLabel}</span>
                  )}
                </div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                <div class="tag-row">
                  {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
