---
import { en } from '../i18n/en';
---
<section class="section projects" id="projects"><div class="container"><div class="projects-top"><div><span class="eyebrow">{en.projects.eyebrow}</span><h2 class="section-heading">{en.projects.title}</h2></div><p class="section-intro">{en.projects.intro}</p></div><div class="project-grid">{en.projects.items.map((project) => (<article class="project-card interactive-card" data-interactive-card tabindex="0"><div class={`project-preview ${project.preview}`} aria-hidden="true"><div class="preview-window"><div class="window-dots"><i></i><i></i><i></i></div><div class="preview-layout"><div class="preview-sidebar"></div><div class="preview-content"><span></span><span></span><span></span></div></div></div></div><div class="project-body"><div class="project-meta"><span>{project.category}</span><a href={project.href} target="_blank" rel="noreferrer">{project.linkLabel} <span aria-hidden="true">-></span></a></div><h3>{project.title}</h3><p>{project.description}</p><div class="tag-row">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div></article>))}</div></div></section>