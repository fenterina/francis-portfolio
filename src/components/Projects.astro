---
import { en } from '../i18n/en';
---
<section class="section projects" id="projects"><div class="container"><div class="projects-top"><div><span class="eyebrow">{en.projects.eyebrow}</span><h2 class="section-heading">{en.projects.title}</h2></div><p class="section-intro">{en.projects.intro}</p></div><div class="project-grid">{en.projects.items.map((project) => (<article class="project-card interactive-card" data-interactive-card data-project-trigger={project.preview === 'preview-red-carpet' ? 'redcarpet-case-study' : undefined} tabindex="0"><div class={`project-preview ${project.preview}`} aria-hidden="true">{project.preview === 'preview-red-carpet' ? <div class="red-carpet-scene"><div class="red-carpet-orbit"></div><div class="red-carpet-dashboard"><div class="dashboard-bar"><span class="dashboard-logo">red<span>carpet</span></span><i></i><i></i></div><div class="dashboard-layout"><div class="dashboard-nav"></div><div class="dashboard-main"><b></b><div class="dashboard-stat-row"><span></span><span></span><span></span></div><div class="dashboard-chart"></div></div></div></div><div class="red-carpet-phone phone-back"><div class="phone-speaker"></div><div class="phone-header">MARKETPLACE</div><div class="phone-icons"><i></i><i></i><i></i><i></i></div><div class="phone-photo"></div><div class="phone-lines"></div><div class="phone-lines short"></div></div><div class="red-carpet-phone phone-front"><div class="phone-speaker"></div><div class="phone-header">COUPLE PLANNER</div><div class="phone-banner">Wedding<br />manual</div><div class="phone-list"><i></i><i></i><i></i></div></div></div> : <div class="preview-window"><div class="window-dots"><i></i><i></i><i></i></div><div class="preview-layout"><div class="preview-sidebar"></div><div class="preview-content"><span></span><span></span><span></span></div></div></div>}</div><div class="project-body"><div class="project-meta"><span>{project.category}</span><a href={project.href} target={project.href.startsWith('#') ? undefined : '_blank'} rel={project.href.startsWith('#') ? undefined : 'noreferrer'}>{project.linkLabel} <span aria-hidden="true">-></span></a></div><h3>{project.title}</h3><p>{project.description}</p><div class="tag-row">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div></article>))}</div></div></section>
<dialog class="project-dialog" id="redcarpet-case-study" aria-labelledby="redcarpet-dialog-title">
  <div class="project-dialog-inner">
    <button class="project-dialog-close" type="button" aria-label="Close Red Carpet case study">Close <span aria-hidden="true">×</span></button>
    <span class="eyebrow">01 / 06 · Mobile app + dashboard</span>
    <h2 id="redcarpet-dialog-title">Red Carpet</h2>
    <p class="project-dialog-lede">An all-in-one wedding planning app that connects couples, wedding planners, and vendors, supported by an admin analytics dashboard.</p>
    <div class="project-dialog-facts">
      <div><span>Client / context</span><strong>Anura Innovations<br />Software Engineer Intern</strong></div>
      <div><span>Year</span><strong>2026</strong></div>
      <div><span>Focus</span><strong>Mobile product, marketplace, dashboard</strong></div>
    </div>
    <div class="project-dialog-columns">
      <div><span>The brief</span><p>Bring wedding planning, vendor discovery, bookings, and coordination into one less stressful experience.</p></div>
      <div><span>What I did</span><p>Helped shape the mobile flows and dashboard experience across role-based journeys, from browsing vendors to managing events.</p></div>
      <div><span>The result</span><p>A connected platform for couples, planners, and vendors, with admin tools for monitoring activity and performance.</p></div>
    </div>
  </div>
</dialog>