---
import { en } from '../i18n/en';
---

<footer class="site-footer" id="footer">
  <div class="footer-stage">
    <!-- 4K Blue Ink Landscape Cityscape Art: Full Width -->
    <picture>
      <source srcset="/images/footer-illustration.webp 1x, /images/footer-illustration@2x.webp 2x" type="image/webp" />
      <img
        class="footer-art-image"
        src="/images/footer-illustration.png"
        srcset="/images/footer-illustration.png 1x, /images/footer-illustration@2x.png 2x"
        alt=""
        width="3072"
        height="1302"
        loading="lazy"
        decoding="async"
      />
    </picture>

    <!-- Original Footer Text Overlaid Directly on Top of the Image -->
    <div class="footer-overlay-bar">
      <div class="container footer-bar">
        <span class="footer-item footer-location">{en.footer.location}</span>
        <span class="footer-item footer-copyright">{en.footer.copyright}</span>
        <a class="footer-item footer-top" href="#top">{en.footer.backToTop} <span aria-hidden="true">↑</span></a>
      </div>
    </div>
  </div>
</footer>
