---
import { en } from '../i18n/en';
---

<section class="section section-white" id="skills"><div class="container skills-grid"><div><span class="eyebrow">{en.skills.eyebrow}</span><h2 class="section-heading">{en.skills.title}</h2><p class="section-intro">{en.skills.intro}</p></div><div class="skill-groups">{en.skills.groups.map((skill, index) => <article class="skill-group interactive-card" data-interactive-card tabindex="0"><div class="skill-icon" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div><h3>{skill.title}</h3><p>{skill.description}</p></article>)}</div></div></section>