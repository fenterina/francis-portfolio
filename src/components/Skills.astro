---
import { en } from '../i18n/en';
import ToolChip from './ToolChip.astro';
import { tools } from '../data/tools';

const leftTools = tools.filter((_, index) => index % 2 === 0);
const rightTools = tools.filter((_, index) => index % 2 === 1);
---

<section class="section section-white" id="skills">
  <div class="container skills-grid">
    <div class="tools-loop tools-loop-left" aria-label="Tools I use">
      <div
        class="tools-column tools-column-down"
        style={`--tool-count: ${leftTools.length}`}
      >
        <div class="tools-column-track">
          {leftTools.map((tool) => <ToolChip tool={tool} />)}
          {leftTools.map((tool) => <ToolChip tool={tool} />)}
        </div>
      </div>
    </div>
    <div class="skills-copy">
      <span class="eyebrow">{en.skills.eyebrow}</span>
      <h2 class="section-heading">{en.skills.title}</h2>
      <p class="section-intro">{en.skills.intro}</p>
    </div>
    <div class="skill-groups">
      <article
        class="skill-group certificate-card interactive-card"
        data-interactive-card
        data-dialog-trigger="certificates-dialog"
        tabindex="0"
      >
        <div class="certificate-card-showcase">
          <img
            src="/certificates/AI Mastery Cert.png"
            alt="AI Mastery certificate"
            loading="lazy"
          />
          <div class="certificate-card-content">
            <h3>Certificates</h3>
            <p>Certificates, Diplomas, and Additional training</p>
            <span class="certificate-card-link">
              View all Certificates <span aria-hidden="true">-&gt;</span>
            </span>
          </div>
        </div>
      </article>
    </div>
    <div class="tools-loop tools-loop-right" aria-label="Tools I use">
      <div
        class="tools-column tools-column-up"
        style={`--tool-count: ${rightTools.length}`}
      >
        <div class="tools-column-track">
          {rightTools.map((tool) => <ToolChip tool={tool} />)}
          {rightTools.map((tool) => <ToolChip tool={tool} />)}
        </div>
      </div>
    </div>
  </div>
</section>
<dialog class="certificate-dialog project-dialog" id="certificates-dialog" aria-labelledby="certificates-dialog-title">
  <div class="project-dialog-inner">
    <button class="project-dialog-close" type="button" aria-label="Close certificates">Close <span aria-hidden="true">×</span></button>
    <h2 id="certificates-dialog-title">Certificates</h2>
    <p class="project-dialog-lede">A collection of certificates and milestones from professional work, learning, and community involvement.</p>
    <div class="certificate-category">
      <div class="certificate-category-heading"><h3>Certificates</h3><span>{en.skills.certificates.length} items</span></div>
      <div class="certificate-grid">{en.skills.certificates.map((certificate) => <div class="certificate-item"><span class="certificate-title">{certificate.title}</span><a class="certificate-preview-trigger" href={`/certificates/${certificate.file}`} data-preview-src={`/certificates/${certificate.file}`} data-preview-title={certificate.title}><img src={`/certificates/${certificate.file}`} alt={certificate.title} loading="lazy" /></a>{certificate.credentialUrl && <a class="credential-link" href={certificate.credentialUrl} target="_blank" rel="noreferrer">Show credential <span aria-hidden="true">↗</span></a>}</div>)}</div>
    </div>
    <div class="certificate-category">
      <div class="certificate-category-heading"><h3>Additional certificates</h3><span>{en.skills.additionalCertificates.length} items</span></div>
      <div class="certificate-grid">{en.skills.additionalCertificates.map((certificate) => <div class="certificate-item"><span class="certificate-title">{certificate.title}</span><a class="certificate-preview-trigger" href={`/additionalCertificates/${certificate.file}`} data-preview-src={`/additionalCertificates/${certificate.file}`} data-preview-title={certificate.title}><img src={`/additionalCertificates/${certificate.file}`} alt={certificate.title} loading="lazy" /></a></div>)}</div>
    </div>
  </div>
</dialog>
<dialog class="certificate-preview" id="certificate-preview" aria-label="Certificate preview">
  <button class="certificate-preview-close" type="button" aria-label="Close certificate preview">Close <span aria-hidden="true">×</span></button>
  <figure>
    <img id="certificate-preview-image" src="" alt="" />
    <figcaption id="certificate-preview-title"></figcaption>
  </figure>
</dialog>