---
import { tools } from '../data/tools';
import { en } from '../i18n/en';
import ToolChip from './ToolChip.astro';

const categories = [...new Set(tools.map((tool) => tool.category))];
const copy = en.skills.toolsDialog;
---

<dialog class="tools-dialog project-dialog" id="tools-dialog" aria-labelledby="tools-dialog-title">
  <div class="tools-dialog-inner">
    <button class="project-dialog-close tools-dialog-close" type="button" aria-label={copy.closeAriaLabel}>
      <span>{copy.closeLabel}</span>
      <svg class="icon-svg" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </button>
    <h2 id="tools-dialog-title">{copy.title}</h2>
    <p class="project-dialog-lede">{copy.lede}</p>
    <div class="tools-modal-groups">
      {categories.map((category) => (
        <section class="tools-modal-category" aria-labelledby={`tools-category-${category.toLowerCase().replaceAll(' ', '-')}`}>
          <h3 id={`tools-category-${category.toLowerCase().replaceAll(' ', '-')}`}>{category}</h3>
          <div class="tools-modal-grid">
            {tools.filter((tool) => tool.category === category).map((tool) => <ToolChip tool={tool} asStatic />)}
          </div>
        </section>
      ))}
    </div>
  </div>
</dialog>
